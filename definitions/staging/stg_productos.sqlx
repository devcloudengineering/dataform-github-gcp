config {
  type: "table",
  schema: "stg",
  tags: ["staging"]
}

SELECT
  CAST(producto_id AS STRING)    AS id_producto,
  UPPER(TRIM(nombre_producto))   AS nombre_producto,
  UPPER(TRIM(categoria))         AS categoria,
  CAST(precio_lista AS NUMERIC)  AS precio_lista
FROM `mi-primer-proyecto-469023.raw.productos_ext`