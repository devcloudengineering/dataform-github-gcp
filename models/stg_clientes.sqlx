config {
    type: "table",
    schema: "stg",
    tags: ["staging"],
    dependencies: ["raw.clientes_ext"]
}

SELECT
  CAST(id_cliente AS string) AS id_cliente,
  UPPER(TRIM(nombre)) AS nombre,
  UPPER(TRIM(region)) AS region,
  UPPER(TRIM(segmento)) AS segmento
FROM
  ${ref("raw", "clientes_ext")};
